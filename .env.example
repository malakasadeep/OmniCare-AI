# ─────────────────────────────────────────────────────────────────────
# OmniCare AI — local environment configuration (template)
#
# Copy this file to `.env` and fill in the required values:
#   cp .env.example .env            # macOS / Linux
#   Copy-Item .env.example .env     # Windows PowerShell
#
# `.env` is gitignored. Never put real secrets in this template file.
#
# Note: plain `./mvnw spring-boot:run` does NOT auto-load `.env`.
# `docker compose` reads it automatically; for the raw backend run,
# export the vars into your shell or use an IDE env-file plugin.
# In week 1 the database defaults below already match docker-compose.yml,
# so the backend starts without `.env`. The other keys matter from
# week 2 (LLM) and week 4 (auth) onward.
# ─────────────────────────────────────────────────────────────────────

# --- Database --------------------------------------------------------
# Must match docker-compose.yml. The backend connects on host port 5433.
# The application must NOT connect as the POSTGRES_USER. That role is a
# superuser, and a superuser bypasses row level security outright, which would
# silently disable every tenant isolation policy in V3__rls.sql.
# docker/postgres-init/01-app-role.sql creates this non-superuser role.
DB_USER=omnicare_app
DB_PASSWORD=omnicare_app_dev

# --- Auth (JWT) -----------------------------------------------------
# Any long random string for local dev. Generate one with:
#   openssl rand -base64 48
# At least 32 bytes. Changing it invalidates every token already issued,
# which is the only revocation a stateless scheme has.
JWT_SECRET=replace-with-a-long-random-string

# --- LLM providers ------------------------------------------------
# Groq is the primary provider. Free key: https://console.groq.com
GROQ_API_KEY=

# Google AI Studio / Gemini — optional fallback provider.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
